# Settings for the backend. Copy these into your shell environment; the app does NOT load this file automatically.
#
# macOS / Linux:          export DB_PASSWORD="your-mysql-password"
# Windows (PowerShell):   $env:DB_PASSWORD = "your-mysql-password"
#
# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=campusnotes

# JWT (REQUIRED, no default). Generate a random secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-string
# Optional: how long a login token stays valid (default 24)
JWT_EXPIRY_HOURS=24
