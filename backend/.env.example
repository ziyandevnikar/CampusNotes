# CampusNotes backend environment.
# This file contains placeholders only. Do NOT commit a real .env file.
#
# Development example (macOS/Linux):
#   export DATABASE_PASSWORD="your-mysql-password"
# Windows PowerShell:
#   $env:DATABASE_PASSWORD = "your-mysql-password"
#
# Production deployments MUST provide these values through the host's secret
# / environment-variable configuration.

# Runtime environment
FLASK_ENV=production
FLASK_DEBUG=0

# MySQL
DATABASE_HOST=your-mysql-host
DATABASE_PORT=3306
DATABASE_NAME=campusnotes
DATABASE_USER=campusnotes_app
DATABASE_PASSWORD=change-me

# JWT (REQUIRED). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_HOURS=24

# Comma-separated frontend origin(s), with no trailing slash.
# Example:
# CORS_ALLOWED_ORIGINS=https://campusnotes.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Persistent upload directory. The default is backend/uploads.
# On a host with a persistent mounted disk, set this to that mount path.
UPLOAD_DIRECTORY=uploads

# Optional local development bind settings; not used by gunicorn.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
